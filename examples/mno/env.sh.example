#!/bin/bash
# Site-specific runtime environment example for the user's Intel 2019 stack.
# Copy to ~/.config/edmft_workflow/env.sh (or another private path) and point
# config.toml [environment].setup_script to it.

INTEL=/opt/intel2019/compilers_and_libraries_2019.4.243
ENV=/home/kyang/miniforge3/envs/edmft

# This is the authoritative Intel compiler/MPI/MKL setup. Keep it before custom
# PATH/LD_LIBRARY_PATH edits so Intel's own environment is initialized first.
source "$INTEL/linux/bin/compilervars.sh" intel64

export WIENROOT=/home/kyang/apps/edmft/wien2k
export WIEN_DMFT_ROOT=/home/kyang/apps/edmft/eDMFT/bin
export EDMFT_PYTHON="$ENV/bin/python"

export PATH="$WIEN_DMFT_ROOT:$WIENROOT:$ENV/bin:$INTEL/linux/bin/intel64:$INTEL/linux/mpi/intel64/bin:/usr/bin:/bin"
export LD_LIBRARY_PATH="$INTEL/linux/mkl/lib/intel64:$INTEL/linux/compiler/lib/intel64_lin:$INTEL/linux/mpi/intel64/lib/release:$INTEL/linux/mpi/intel64/lib:/opt/fftw-3.3.10/lib:$ENV/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$WIEN_DMFT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

# Intel MPI behavior used on the PBS cluster.
export I_MPI_HYDRA_BOOTSTRAP=ssh
export I_MPI_FABRICS=shm

# MPI ranks are managed by PBS / mpi_prefix.dat / .machines. Keep each MPI rank
# single-threaded unless a calculation has explicitly been tuned otherwise.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
