# Site-specific example based on an Intel 2019 + WIEN2k/eDMFT installation.
# Keep the real env.sh outside Git if it contains site-specific details you do not want tracked.
INTEL=/opt/intel2019/compilers_and_libraries_2019.4.243
source "$INTEL/linux/bin/compilervars.sh" intel64

export WIENROOT=/home/kyang/apps/edmft/wien2k
export WIEN_DMFT_ROOT=/home/kyang/apps/edmft/eDMFT/bin
export EDMFT_PYTHON=/home/kyang/miniforge3/envs/edmft/bin/python

export PATH="$WIEN_DMFT_ROOT:$WIENROOT:/home/kyang/miniforge3/envs/edmft/bin:$PATH"
export LD_LIBRARY_PATH="$INTEL/linux/mkl/lib/intel64:$INTEL/linux/compiler/lib/intel64_lin:$INTEL/linux/mpi/intel64/lib/release:$INTEL/linux/mpi/intel64/lib:/opt/fftw-3.3.10/lib:/home/kyang/miniforge3/envs/edmft/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$WIEN_DMFT_ROOT:${PYTHONPATH:-}"
export I_MPI_HYDRA_BOOTSTRAP=ssh
export I_MPI_FABRICS=shm
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
