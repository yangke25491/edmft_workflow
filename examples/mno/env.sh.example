#!/bin/bash
# Site-specific runtime environment template.
# Replace all placeholder paths below with values for your own installation.
# Copy to ~/.config/edmft_workflow/env.sh (or another private path) and point
# config.toml [environment].setup_script to it.

INTEL=/path/to/intel
ENV=/home/USER/miniforge3/envs/edmft
FFTW_LIB=/path/to/fftw/lib

# Initialize the compiler/MPI/MKL environment before custom PATH and
# LD_LIBRARY_PATH edits. Adjust this command for your installed toolchain.
source "$INTEL/linux/bin/compilervars.sh" intel64

export WIENROOT=/home/USER/apps/edmft/wien2k
export WIEN_DMFT_ROOT=/home/USER/apps/edmft/eDMFT/bin
export EDMFT_PYTHON="$ENV/bin/python"

export PATH="$WIEN_DMFT_ROOT:$WIENROOT:$ENV/bin:$INTEL/linux/bin/intel64:$INTEL/linux/mpi/intel64/bin:/usr/bin:/bin"
export LD_LIBRARY_PATH="$INTEL/linux/mkl/lib/intel64:$INTEL/linux/compiler/lib/intel64_lin:$INTEL/linux/mpi/intel64/lib/release:$INTEL/linux/mpi/intel64/lib:$FFTW_LIB:$ENV/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$WIEN_DMFT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

# MPI behavior for a PBS-style cluster. Adjust for the local scheduler/network.
export I_MPI_HYDRA_BOOTSTRAP=ssh
export I_MPI_FABRICS=shm

# MPI ranks are managed by the scheduler / mpi_prefix.dat / .machines. Keep each
# MPI rank single-threaded unless a calculation has explicitly been tuned otherwise.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
